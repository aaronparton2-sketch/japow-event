# JAPOW EVENT - copy to .env and fill in.
# In n8n these belong in CREDENTIALS, not in node parameters. This file is a
# checklist of what you need to collect, not somewhere to run the system from.

# Telegram - from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase - holds the trip state between workflows
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Apify - flight and chalet lookups. SET A SPEND CAP FIRST.
APIFY_TOKEN=

# AeroDataBox via RapidAPI - live flight tracking
RAPIDAPI_KEY=

# Bland.ai - the taxi and beer phone calls
BLAND_API_KEY=
PHONE_NUMBER=
